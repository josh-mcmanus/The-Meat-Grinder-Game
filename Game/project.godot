; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Meat Grinder"
run/main_scene="uid://drfg2tcounig7"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://Assets/Old/icon.svg"

[audio]

buses/default_bus_layout="uid://peppk64l2le6"

[autoload]

DataManager="*uid://cs40vmg4w2t1f"
LaunchSetup="*uid://c4www74brpn4w"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/quality/screen_space_aa=0
window/quality/msaa_2d=0
window/hdr_2d=false

[dotnet]

project/assembly_name="The Meat Grinder"

[editor_plugins]

enabled=PackedStringArray("res://addons/softbody2d/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "red",
"res://Code/": "orange",
"res://Notes/": "yellow",
"res://Scenes/": "green"
}

